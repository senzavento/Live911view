{
  "name": "@live911/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && npm run bundle",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --external:fastify --external:@fastify/*",
    "start:prod": "node dist/index.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.10",
    "@live911/shared": "*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0"
  }
}
